{
  "permissions": {
    "allow": [
      "Bash(./validate)",
      "Bash(cat:*)",
      "Bash(cd:*)",
      "Bash(find:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(grep:*)",
      "Bash(npx serve:*)",
      "Bash(rm:*)",
      "Bash(TMPDIR=/tmp/claude ./build:*)",
      "Bash(TMPDIR=/tmp/claude ./validate)",
      "Bash(xargs -I {} basename {})",
      "Skill(church-of-code:church-of-code)",
      "Skill(commit-commands:commit)",
      "Skill(update-config)",
      "WebFetch(domain:localhost)",
      "WebFetch(domain:raw.githubusercontent.com)"
    ]
  },
  "outputStyle": "Explanatory",
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowUnixSockets": [
        "/tmp/claude/tsx-501"
      ],
      "allowLocalBinding": true
    },
    "filesystem": {
      "allowWrite": [
        "/Users/tmornini/.npm-cache",
        "/Users/tmornini/Desktop"
      ]
    }
  }
}
