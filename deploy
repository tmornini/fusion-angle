#!/bin/bash
set -euo pipefail

usage() {
    cat <<'USAGE'
Usage: ./deploy {--local PORT | --render TOKEN}
                {--postgres mock-data|bootstrap
                 | --commit SHA}
USAGE
}

ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "$ROOT"

LOCAL_PORT=""
RENDER_TOKEN=""
COMMIT_SHA=""
BOOTSTRAP=false
MOCK_DATA=false

while [ $# -gt 0 ]; do
    case "$1" in
        --help|-h)
            usage
            exit 0
            ;;
        --local)
            if [ $# -lt 2 ]; then
                echo "Error: --local requires PORT" >&2
                usage >&2
                exit 1
            fi
            LOCAL_PORT="$2"
            shift 2
            ;;
        --render)
            if [ $# -lt 2 ]; then
                echo "Error: --render requires TOKEN" >&2
                usage >&2
                exit 1
            fi
            RENDER_TOKEN="$2"
            shift 2
            ;;
        --commit)
            if [ $# -lt 2 ]; then
                echo "Error: --commit requires SHA" >&2
                usage >&2
                exit 1
            fi
            COMMIT_SHA="$2"
            shift 2
            ;;
        --postgres)
            if [ $# -lt 2 ]; then
                echo "Error: --postgres requires" \
                    "a value" >&2
                usage >&2
                exit 1
            fi
            case "$2" in
                mock-data) MOCK_DATA=true ;;
                bootstrap) BOOTSTRAP=true ;;
                *)
                    echo "Error: --postgres must be" \
                        "mock-data or bootstrap" >&2
                    usage >&2
                    exit 1
                    ;;
            esac
            shift 2
            ;;
        -*)
            echo "Error: unknown argument: $1" >&2
            usage >&2
            exit 1
            ;;
        *)
            echo "Error: unexpected argument:" \
                "$1" >&2
            usage >&2
            exit 1
            ;;
    esac
done

MODE_COUNT=0
if [ "$BOOTSTRAP" = true ]; then
    MODE_COUNT=$((MODE_COUNT + 1))
fi
if [ "$MOCK_DATA" = true ]; then
    MODE_COUNT=$((MODE_COUNT + 1))
fi

if [ "$MODE_COUNT" -gt 1 ]; then
    echo "Error: --postgres mock-data and" \
        "--postgres bootstrap are exclusive" >&2
    usage >&2
    exit 1
fi

if [ -n "$LOCAL_PORT" ] && [ -n "$RENDER_TOKEN" ]; then
    echo "Error: --local and --render are" \
        "exclusive" >&2
    usage >&2
    exit 1
fi

if [ -z "$LOCAL_PORT" ] && [ -z "$RENDER_TOKEN" ]; then
    echo "Error: --local or --render is" \
        "required" >&2
    usage >&2
    exit 1
fi

if [ -n "$LOCAL_PORT" ] && [ -n "$COMMIT_SHA" ]; then
    echo "Error: --local and --commit are" \
        "exclusive" >&2
    usage >&2
    exit 1
fi

if [ -n "$COMMIT_SHA" ] && [ "$MODE_COUNT" -gt 0 ]; then
    echo "Error: --commit and --postgres are" \
        "exclusive" >&2
    usage >&2
    exit 1
fi

if [ -n "$LOCAL_PORT" ] && [ "$MODE_COUNT" -eq 0 ]; then
    echo "Error: --local requires --postgres" >&2
    usage >&2
    exit 1
fi

if [ -n "$RENDER_TOKEN" ] \
    && [ -z "$COMMIT_SHA" ] \
    && [ "$MODE_COUNT" -eq 0 ]
then
    echo "Error: --render requires --commit or" \
        "--postgres" >&2
    usage >&2
    exit 1
fi

if [ "$BOOTSTRAP" = true ]; then
    MODE='--bootstrap'
else
    MODE='--mock-data'
fi

CLEANED=""
cleanup() {
    if [ -n "${CLEANED:-}" ]; then
        return
    fi
    CLEANED=1
    docker compose down --remove-orphans || true
}

if [ -n "$LOCAL_PORT" ]; then
    ./test validate
    ./test postgres
    ./test browser

    POSTGRES_PASSWORD="$(openssl rand -hex 16)"
    JWT_HMAC_SIGNING_KEY="$(openssl rand -hex 32)"
    export POSTGRES_PASSWORD
    export JWT_HMAC_SIGNING_KEY
    export PORT="$LOCAL_PORT"
    POSTGRES_URL="postgres://fusion:${POSTGRES_PASSWORD}"
    POSTGRES_URL="${POSTGRES_URL}@127.0.0.1:5432/fusion"
    export POSTGRES_URL

    trap cleanup EXIT
    trap 'cleanup; exit 130' INT
    trap 'cleanup; exit 143' TERM

    docker compose up -d --wait postgres
    docker compose build
    ./bin/postgres-wipe --postgres local
    ./bin/postgres-seed --postgres local "$MODE"
    docker compose up -d --wait server

    # Park until interrupt; the trap downs compose.
    while true; do
        sleep 3600
    done
fi

export RENDER_API_KEY="$RENDER_TOKEN"
unset TOKEN
# shellcheck disable=SC1091
. "$ROOT/bin/postgres-lib"
assert_render_cli

TMP=$(mktemp -d \
    "${TMPDIR:-/tmp}/fusion-deploy.XXXXXX")
trap 'rm -rf "$TMP"' EXIT

if [ -n "$COMMIT_SHA" ]; then
    REMOTE=$(git ls-remote origin refs/heads/master | awk '{print $1}')
    if [ "$REMOTE" != "$COMMIT_SHA" ]; then
        echo "Error: SHA is not origin/master" >&2
        exit 1
    fi
fi

discover_render_ids

ORACLE_TIMEOUT_SEC=20

if [ -n "$COMMIT_SHA" ]; then
    render deploys create "$SERVICE_ID" \
        --commit "$COMMIT_SHA" \
        --wait --confirm -o json
    for host in fusionangle.com fusionangle.ai; do
        for path in / /landing/index.html \
            /api/organizations; do
            want=200
            if [ "$path" = "/api/organizations" ]; then
                want=401
            fi
            code=$(curl -sS -o /dev/null \
                --max-time "$ORACLE_TIMEOUT_SEC" \
                -w '%{http_code}' \
                "https://${host}${path}")
            echo "${host} ${path} ${code}"
            if [ "$code" != "$want" ]; then
                echo "Error: ${host}${path}" \
                    "returned ${code}, expected" \
                    "${want}" >&2
                exit 1
            fi
        done
    done
    for host in www.fusionangle.com \
        www.fusionangle.ai; do
        apex="${host#www.}"
        out=$(curl -sS -o /dev/null \
            --max-time "$ORACLE_TIMEOUT_SEC" \
            -w '%{http_code} %{redirect_url}' \
            "https://${host}/")
        echo "${host} / ${out}"
        code=${out%% *}
        loc=${out#* }
        if [ "$code" != "301" ]; then
            echo "Error: ${host}/ returned" \
                "${code}, expected 301" >&2
            exit 1
        fi
        case "$loc" in
            "https://${apex}/"|"https://${apex}")
                ;;
            *)
                echo "Error: ${host}/ redirected" \
                    "to ${loc}, expected" \
                    "https://${apex}/" >&2
                exit 1
                ;;
        esac
    done
    echo "Revoke the API key at ${DASHBOARD_KEYS}" >&2
    exit 0
fi

./bin/postgres-wipe --postgres render \
    "$RENDER_API_KEY"
./bin/postgres-seed --postgres render \
    "$RENDER_API_KEY" "$MODE"
