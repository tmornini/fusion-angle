#!/bin/bash
set -euo pipefail

usage() {
    cat <<'USAGE'
Usage: ./build [--no-zip] [path/]

Options:
  path/      Output directory (trailing / required)
             Default: ~/Desktop/
  --no-zip   Create bundle directory without zipping
             (the fusion-angle executable — for ./crank)
  --help     Show this help message

Examples:
  ./build                          # server ZIP to ~/Desktop/
  ./build dist/                    # server ZIP to dist/
  ./build --no-zip /tmp/test/      # server bundle to /tmp/test/
  ./build --no-zip                 # server bundle to ~/Desktop/
USAGE
}

NO_ZIP=false
DEST=""

for arg in "$@"; do
    case "$arg" in
        --help|-h) usage; exit 0 ;;
        --no-zip)  NO_ZIP=true ;;
        */)        DEST="$arg" ;;
        *)
            echo "Error: unknown argument: $arg" >&2
            usage >&2
            exit 1
            ;;
    esac
done

# shellcheck source=build-lib
source "$(dirname "$0")/build-lib"

if [ -n "$(git status --porcelain)" ]; then
    echo "Error: working directory is not clean." \
        "Commit or stash changes before building." >&2
    exit 1
fi

echo "Building Fusion Angle..."

if [ "$NO_ZIP" = true ] && [ -n "$DEST" ]; then
    BUILD_DIR="$DEST"
    mkdir -p "$BUILD_DIR"
elif [ "$NO_ZIP" = true ]; then
    BUILD_DIR=$(mktemp -d "${TMPDIR:-/tmp}/fusion-build.XXXXXX")
else
    BUILD_DIR=$(mktemp -d "${TMPDIR:-/tmp}/fusion-build.XXXXXX")
    trap 'rm -rf "$BUILD_DIR"' EXIT
fi

bundle_client "$BUILD_DIR/site"

if [ "$NO_ZIP" = true ]; then
    TARGET_FLAG=""
else
    TARGET_FLAG="--target x86_64-unknown-linux-gnu"
fi

ROOT="$(cd "$(dirname "$0")" && pwd)"
ABS_BUILD="$(cd "$BUILD_DIR" && pwd)"
# deno compile looks up absolute file:// specifiers on
# disk at runtime, so the generated entry must be
# relative for the binary to run without the source tree.
SERVER_IMPORT=$(
    printf '%s' '
        import { relative } from "@std/path/posix";
        let rel = relative(
            Deno.args[0],
            Deno.args[1],
        );
        if (!rel.startsWith(".")) rel = "./" + rel;
        console.log(rel);
    ' | deno run --frozen --config "$ROOT/deno.json" \
        - "$ABS_BUILD" "$ROOT/server/main.ts"
)
cat > "$BUILD_DIR/main.ts" <<ENTRY
import { dispatch } from '${SERVER_IMPORT}';
Deno.exit(await dispatch(
    new URL('./site/', import.meta.url),
    Deno.args,
));
ENTRY

deno compile --frozen --exclude-unused-npm \
    --config "$ROOT/deno.json" \
    --include "$BUILD_DIR/site" \
    --allow-net \
    --allow-env=POSTGRES_URL,PGPORT,PGSSL,PGSSLNEGOTIATION,PGIDLE_TIMEOUT,\
PGCONNECT_TIMEOUT,PGMAX_LIFETIME,PGMAX_PIPELINE,PGBACKOFF,\
PGKEEP_ALIVE,PGPREPARE,PGDEBUG,PGFETCH_TYPES,PGPUBLICATIONS,\
PGTARGET_SESSION_ATTRS,PGAPPNAME,PGTARGETSESSIONATTRS,\
JWT_HMAC_SIGNING_KEY,HTTP_SERVER_PORT,TRUSTED_PROXY_HOPS \
    ${TARGET_FLAG} \
    -o "$BUILD_DIR/fusion-angle" \
    "$BUILD_DIR/main.ts"

emitted "Executable created" "$BUILD_DIR/fusion-angle"

if [ "$NO_ZIP" = true ]; then
    echo "Bundle: $BUILD_DIR"
else
    SHA=$(git rev-parse --short=7 HEAD)
    DEST_DIR="${DEST:-$HOME/Desktop/}"
    SERVER_ZIP="${DEST_DIR}fusion-angle-${SHA}.zip"
    (cd "$BUILD_DIR" && zip -r "$SERVER_ZIP" .)
    echo "Distribution: $SERVER_ZIP" \
        "($(wc -c < "$SERVER_ZIP" | xargs) bytes)"
fi
echo "Done."
