#!/bin/bash
set -euo pipefail

usage() {
    cat <<'USAGE'
Usage: ./build [--no-zip] [path/]

Options:
  path/      Output directory (trailing / required)
             Default: ~/Desktop/
  --no-zip   Create bundle directory without zipping
             (server-core + server.mjs — for ./crank)
  --help     Show this help message

Examples:
  ./build                          # server ZIP to ~/Desktop/
  ./build dist/                    # server ZIP to dist/
  ./build --no-zip /tmp/test/      # server bundle to /tmp/test/
  ./build --no-zip                 # server bundle to ~/Desktop/
USAGE
}

NO_ZIP=false
DEST=""

for arg in "$@"; do
    case "$arg" in
        --help|-h) usage; exit 0 ;;
        --no-zip)  NO_ZIP=true ;;
        */)        DEST="$arg" ;;
        *)
            echo "Error: unknown argument: $arg" >&2
            usage >&2
            exit 1
            ;;
    esac
done

# shellcheck source=build-lib
source "$(dirname "$0")/build-lib"

if [ -n "$(git status --porcelain)" ]; then
    echo "Error: working directory is not clean." \
        "Commit or stash changes before building." >&2
    exit 1
fi

echo "Building Fusion Angle..."

if [ "$NO_ZIP" = true ] && [ -n "$DEST" ]; then
    BUILD_DIR="$DEST"
    mkdir -p "$BUILD_DIR"
elif [ "$NO_ZIP" = true ]; then
    BUILD_DIR=$(mktemp -d "${TMPDIR:-/tmp}/fusion-build.XXXXXX")
else
    BUILD_DIR=$(mktemp -d "${TMPDIR:-/tmp}/fusion-build.XXXXXX")
    trap 'rm -rf "$BUILD_DIR"' EXIT
fi

bundle_client "$BUILD_DIR"

npx --no-install esbuild \
    server/boot.ts \
    --bundle \
    --platform=node \
    --format=esm \
    --target=es2024 \
    --keep-names \
    --outfile="$BUILD_DIR/server.mjs"

emitted "Server process created" \
    "$BUILD_DIR/server.mjs"

if [ "$NO_ZIP" = true ]; then
    echo "Bundle: $BUILD_DIR"
else
    SHA=$(git rev-parse --short=7 HEAD)
    DEST_DIR="${DEST:-$HOME/Desktop/}"
    SERVER_ZIP="${DEST_DIR}fusion-angle-server-${SHA}.zip"
    (cd "$BUILD_DIR" && zip -r "$SERVER_ZIP" .)
    echo "Distribution: $SERVER_ZIP" \
        "($(wc -c < "$SERVER_ZIP" | xargs) bytes)"
fi
echo "Done."
