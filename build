#!/bin/bash
set -euo pipefail

usage() {
    cat <<'USAGE'
Usage: ./build [--no-zip] [path/]

Options:
  path/      Output directory (trailing / required)
             Default: ~/Desktop/
  --no-zip   Create bundle directory without zipping
             (browser entry — for ./serve)
  --help     Show this help message

Examples:
  ./build                          # two ZIPs to ~/Desktop/
  ./build dist/                    # two ZIPs to dist/
  ./build --no-zip /tmp/test/      # browser bundle to /tmp/test/
  ./build --no-zip                 # browser bundle to ~/Desktop/
USAGE
}

NO_ZIP=false
DEST=""

for arg in "$@"; do
    case "$arg" in
        --help|-h) usage; exit 0 ;;
        --no-zip)  NO_ZIP=true ;;
        */)        DEST="$arg" ;;
        *)
            echo "Error: unknown argument: $arg" >&2
            usage >&2
            exit 1
            ;;
    esac
done

if [ -n "$(git status --porcelain)" ]; then
    echo "Error: working directory is not clean." \
        "Commit or stash changes before building." >&2
    exit 1
fi

./validate

echo "Building Fusion AI..."

if [ "$NO_ZIP" = true ] && [ -n "$DEST" ]; then
    BUILD_DIR="$DEST"
    mkdir -p "$BUILD_DIR"
elif [ "$NO_ZIP" = true ]; then
    BUILD_DIR=$(mktemp -d "${TMPDIR:-/tmp}/fusion-build.XXXXXX")
else
    BUILD_DIR=$(mktemp -d "${TMPDIR:-/tmp}/fusion-build.XXXXXX")
    trap 'rm -rf "$BUILD_DIR"' EXIT
fi

node --strip-types web-app/app/compose.ts "$BUILD_DIR"

# Fail when the artifact is empty or absent; report its
# size otherwise — one voice for every emitted artifact.
emitted() {
    local label="$1" path="$2"
    local name
    name=$(basename "$path")
    if [ ! -s "$path" ]; then
        echo "ERROR: $name is empty or missing" >&2
        exit 1
    fi
    echo "$label: assets/$name" \
        "($(wc -c < "$path" | xargs) bytes)"
}

mkdir -p "$BUILD_DIR/assets"
npx --no-install esbuild web-app/app/core.ts \
    --bundle \
    --minify \
    --keep-names \
    --target=es2024 \
    --format=iife \
    --outfile="$BUILD_DIR/assets/app.js"

emitted "Bundle created" "$BUILD_DIR/assets/app.js"

# Pre-app bootstrap scripts: extracted from former inline
# <script> blocks so the page can run with a strict
# Content-Security-Policy (script-src 'self').
npx --no-install esbuild web-app/app/theme-init.ts \
    --bundle \
    --minify \
    --target=es2024 \
    --format=iife \
    --outfile="$BUILD_DIR/assets/theme-init.js"

emitted "Bundle created" "$BUILD_DIR/assets/theme-init.js"

npx --no-install esbuild web-app/app/root-redirect.ts \
    --bundle \
    --minify \
    --target=es2024 \
    --format=iife \
    --outfile="$BUILD_DIR/assets/root-redirect.js"

emitted "Bundle created" "$BUILD_DIR/assets/root-redirect.js"

cat web-app/app/styles/tokens.css \
    web-app/app/styles/fonts.css \
    web-app/app/styles/light-mode.css \
    web-app/app/styles/dark-mode.css \
    web-app/app/styles/base.css \
    web-app/app/styles/components-*.css \
    web-app/app/styles/layout.css \
    web-app/app/styles/utilities.css \
    web-app/app/styles/responsive.css \
    web-app/app/styles/command-palette.css \
    | npx --no-install esbuild --loader=css --minify \
    > "$BUILD_DIR/assets/styles.css"

emitted "Styles created" "$BUILD_DIR/assets/styles.css"

for f in web-app/app/styles/pages-*.css; do
    [ -f "$f" ] || continue
    name=$(basename "$f" .css)
    npx --no-install esbuild --minify "$f" \
        --outfile="$BUILD_DIR/assets/$name.css"
    emitted "Styles created" "$BUILD_DIR/assets/$name.css"
done
cp web-app/assets/*.woff2 "$BUILD_DIR/assets/"
cp web-app/index.html "$BUILD_DIR/"
cp web-app/assets/favicon.ico "$BUILD_DIR/assets/"
cp web-app/assets/favicon.svg "$BUILD_DIR/assets/"

if [ "$NO_ZIP" = true ]; then
    echo "Bundle: $BUILD_DIR"
else
    SHA=$(git rev-parse --short=7 HEAD)
    DEST_DIR="${DEST:-$HOME/Desktop/}"
    BROWSER_ZIP="${DEST_DIR}fusion-ai-browser-${SHA}.zip"
    (cd "$BUILD_DIR" && zip -r "$BROWSER_ZIP" .)
    echo "Distribution: $BROWSER_ZIP" \
        "($(wc -c < "$BROWSER_ZIP" | xargs) bytes)"

    npx --no-install esbuild \
        web-app/app/server-core.ts \
        --bundle \
        --minify \
        --keep-names \
        --target=es2024 \
        --format=iife \
        --outfile="$BUILD_DIR/assets/app.js"

    emitted "Server bundle created" \
        "$BUILD_DIR/assets/app.js"

    npx --no-install esbuild \
        server/boot.ts \
        --bundle \
        --platform=node \
        --format=esm \
        --target=es2024 \
        --keep-names \
        --outfile="$BUILD_DIR/server.mjs"

    emitted "Server process created" \
        "$BUILD_DIR/server.mjs"

    SERVER_ZIP="${DEST_DIR}fusion-ai-server-${SHA}.zip"
    (cd "$BUILD_DIR" && zip -r "$SERVER_ZIP" .)
    echo "Distribution: $SERVER_ZIP" \
        "($(wc -c < "$SERVER_ZIP" | xargs) bytes)"
fi
echo "Done."
