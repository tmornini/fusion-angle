#!/bin/bash
set -euo pipefail

# shellcheck disable=SC1091
. "$(dirname "$0")/postgres-lib"

usage() {
    cat <<'USAGE'
Usage: ./postgres-seed --postgres local
       --bootstrap|--mock-data
       ./postgres-seed --postgres render TOKEN
       --bootstrap|--mock-data
       ./postgres-seed --postgres compose
       --bootstrap|--mock-data

Seed an empty Postgres. --postgres is
required and has no default. --postgres render
needs TOKEN (the confirmation). --postgres local
uses POSTGRES_URL (loopback only); it takes no
TOKEN. --postgres compose seeds the compose
stack; it takes no TOKEN and reads
POSTGRES_PASSWORD through compose.yaml.

Options:
  --postgres render|local|compose   Target (required)
  --bootstrap   Seed bootstrap identities
  --mock-data   Seed mock data
  --help       Show this help message

render: TOKEN must see exactly one Postgres and
one web service. HTTP only (curl).
local: assert loopback, then
node --strip-types server/postgres-seed.ts.
compose: docker compose run --rm seed MODE — the
Render job command inside the builder image.
Development gun.
USAGE
}

POSTGRES_TARGET=''
TOKEN=''
BOOTSTRAP=false
MOCK_DATA=false

while [ $# -gt 0 ]; do
    case "$1" in
        --help|-h)
            usage
            exit 0
            ;;
        --postgres)
            if [ $# -lt 2 ]; then
                echo "Error: --postgres requires" \
                    "a value" >&2
                usage >&2
                exit 1
            fi
            POSTGRES_TARGET="$2"
            shift 2
            ;;
        --bootstrap)
            BOOTSTRAP=true
            shift
            ;;
        --mock-data)
            MOCK_DATA=true
            shift
            ;;
        -*)
            echo "Error: unknown argument: $1" >&2
            usage >&2
            exit 1
            ;;
        *)
            if [ -n "$TOKEN" ]; then
                echo "Error: unexpected argument:" \
                    "$1" >&2
                usage >&2
                exit 1
            fi
            TOKEN="$1"
            shift
            ;;
    esac
done

MODE_COUNT=0
if [ "$BOOTSTRAP" = true ]; then
    MODE_COUNT=$((MODE_COUNT + 1))
fi
if [ "$MOCK_DATA" = true ]; then
    MODE_COUNT=$((MODE_COUNT + 1))
fi

if [ "$MODE_COUNT" -gt 1 ]; then
    echo "Error: --bootstrap and --mock-data are" \
        "exclusive" >&2
    usage >&2
    exit 1
fi

if [ "$MODE_COUNT" -eq 0 ]; then
    echo "Error: exactly one of --bootstrap or" \
        "--mock-data is required" >&2
    usage >&2
    exit 1
fi

case "$POSTGRES_TARGET" in
    '')
        echo "Error: --postgres is required" >&2
        usage >&2
        exit 1
        ;;
    render|local|compose)
        ;;
    *)
        echo "Error: --postgres must be render," \
            "local, or compose" >&2
        usage >&2
        exit 1
        ;;
esac

if [ "$POSTGRES_TARGET" = "render" ] \
    && [ -z "$TOKEN" ]; then
    echo "Error: TOKEN is required" >&2
    usage >&2
    exit 1
fi

if [ "$POSTGRES_TARGET" = "local" \
    -o "$POSTGRES_TARGET" = "compose" ] \
    && [ -n "$TOKEN" ]; then
    echo "Error: unexpected argument" >&2
    usage >&2
    exit 1
fi

if [ "$BOOTSTRAP" = true ]; then
    MODE='--bootstrap'
else
    MODE='--mock-data'
fi

if [ "$POSTGRES_TARGET" = "compose" ]; then
    if ! command -v docker >/dev/null; then
        echo "Error: docker is required" >&2
        exit 1
    fi
    ROOT="$(cd "$(dirname "$0")" && pwd)"
    exec docker compose -f "$ROOT/compose.yaml" \
        run --rm seed "$MODE"
fi

if ! command -v node >/dev/null; then
    echo "Error: node is required" >&2
    exit 1
fi

if [ "$POSTGRES_TARGET" = "local" ]; then
    assert_loopback_postgres_url
    ROOT="$(cd "$(dirname "$0")" && pwd)"
    exec node --strip-types \
        "$ROOT/server/postgres-seed.ts" "$MODE"
fi

if ! command -v curl >/dev/null; then
    echo "Error: curl is required" >&2
    exit 1
fi
export RENDER_API_KEY="$TOKEN"
unset TOKEN

cleanup() {
    rm -rf "$TMP"
}

TMP=$(mktemp -d \
    "${TMPDIR:-/tmp}/fusion-seed.XXXXXX")
trap cleanup EXIT

discover_render_ids

write_job_body "$TMP/seed-job.json" \
    "./render-out/fusion-angle seed ${MODE}"
http_json POST \
    "/services/${SERVICE_ID}/jobs" \
    "$TMP/seed-created.json" \
    "$TMP/seed-job.json"

JOB_ID=$(job_id_from \
    "$TMP/seed-created.json" seed)
SEED_START=$(start_rfc3339)
wait_for_job "$JOB_ID" "$REVEAL_TIMEOUT_SEC" seed

fetch_logs "$OWNER_ID" "$JOB_ID" "$SEED_START" \
    "$TMP/logs.json"
flatten_render_logs "$TMP/logs.json" \
    "$TMP/logs.txt"
print_reveal_lines "$TMP/logs.txt"

http_json POST \
    "/services/${SERVICE_ID}/restart" \
    "$TMP/restart.json"

echo "Revoke the API key at ${DASHBOARD_KEYS}" >&2
exit 0
