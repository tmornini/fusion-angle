#!/bin/bash
# Edit session. Postgres for this compose project is
# created and seeded when it is not already running,
# and left in place when it is. Exit does not take
# the stack down. ./bin/develop bundle only recomposes
# the site directory the server stats on each request.
set -euo pipefail

usage() {
    cat <<'USAGE'
Usage: ./bin/develop PORT [--postgres mock-data|bootstrap]
       ./bin/develop bundle

  PORT        Listen port. Required. No default.
  --postgres  How to seed a new database:
              mock-data or bootstrap. Required
              when Postgres is not running.
  bundle      Recompose the site and exit.

The first run creates a fresh Postgres, seeds
it, and serves. A later run while that Postgres
is up reuses it and does not reseed. Exit
leaves Postgres up. Drop it with:
  docker compose -p fusion-develop down

The site directory is $TMPDIR/fusion-develop
(FUSION_DEVELOP_DIR overrides it).
USAGE
}

valid_port() {
    case "$1" in
        [1-9]) ;;
        [1-9][0-9]) ;;
        [1-9][0-9][0-9]) ;;
        [1-9][0-9][0-9][0-9]) ;;
        [1-9][0-9][0-9][0-9][0-9]) ;;
        *) return 1 ;;
    esac
    [ "$1" -le 65535 ]
}

BIN="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$BIN/.." && pwd)"
cd "$ROOT"
# shellcheck source=build-lib
source "$BIN/build-lib"
# shellcheck source=compose-lib
source "$BIN/compose-lib"

ALLOW_ENV=POSTGRES_URL,PGPORT,PGSSL,PGSSLNEGOTIATION
ALLOW_ENV="$ALLOW_ENV,PGIDLE_TIMEOUT,PGCONNECT_TIMEOUT"
ALLOW_ENV="$ALLOW_ENV,PGMAX_LIFETIME,PGMAX_PIPELINE"
ALLOW_ENV="$ALLOW_ENV,PGBACKOFF,PGKEEP_ALIVE,PGPREPARE"
ALLOW_ENV="$ALLOW_ENV,PGDEBUG,PGFETCH_TYPES"
ALLOW_ENV="$ALLOW_ENV,PGPUBLICATIONS"
ALLOW_ENV="$ALLOW_ENV,PGTARGET_SESSION_ATTRS,PGAPPNAME"
ALLOW_ENV="$ALLOW_ENV,PGTARGETSESSIONATTRS"
ALLOW_ENV="$ALLOW_ENV,JWT_HMAC_SIGNING_KEY,PORT"
ALLOW_ENV="$ALLOW_ENV,TRUSTED_PROXY_HOPS"

session_paths() {
    SESSION_ROOT="${FUSION_DEVELOP_DIR:-}"
    if [ -z "$SESSION_ROOT" ]; then
        SESSION_ROOT="${TMPDIR:-/tmp}/fusion-develop"
    fi
    mkdir -p "$SESSION_ROOT"
    SESSION_ROOT="$(cd "$SESSION_ROOT" && pwd)"
    SESSION_ENV="$SESSION_ROOT/session.env"
    SITE="$SESSION_ROOT/site"
}

write_session() {
    cat > "$SESSION_ENV" <<EOF
POSTGRES_PASSWORD=$POSTGRES_PASSWORD
JWT_HMAC_SIGNING_KEY=$JWT_HMAC_SIGNING_KEY
POSTGRES_URL=$POSTGRES_URL
EOF
    chmod 600 "$SESSION_ENV"
}

postgres_running() {
    local id
    id="$(docker compose ps --status running \
        --quiet postgres)"
    [ -n "$id" ]
}

serve_site() {
    bundle_client "$SITE"
    echo
    echo "Serving on http://localhost:$PORT/"
    exec deno run --frozen --allow-net \
        --allow-read="$SITE" \
        --allow-env="$ALLOW_ENV" \
        server/develop-main.ts "${SITE}/"
}

prepare_database() {
    export COMPOSE_PROJECT_NAME=fusion-develop
    export PORT="$PORT_ARG"
    local have_session=0
    if [ -f "$SESSION_ENV" ]; then
        set -a
        # shellcheck disable=SC1090
        . "$SESSION_ENV"
        set +a
        export PORT="$PORT_ARG"
        have_session=1
    else
        mint_compose_env "$PORT_ARG"
    fi
    if postgres_running; then
        if [ "$have_session" -eq 0 ]; then
            echo "Error: Postgres is up but the" \
                "session file is missing." >&2
            echo "Error: docker compose -p" \
                "fusion-develop down, then run" \
                "again." >&2
            exit 1
        fi
        echo "Postgres is up; leaving the" \
            "database in place." >&2
        return
    fi
    if [ -z "$MODE" ]; then
        echo "Error: --postgres is required when" \
            "Postgres is not running." >&2
        usage >&2
        exit 1
    fi
    if [ "$have_session" -eq 1 ]; then
        mint_compose_env "$PORT_ARG"
    fi
    write_session
    docker compose down --remove-orphans
    docker compose up -d --wait postgres
    if ! deno run --frozen --allow-net \
        --allow-env="$ALLOW_ENV" \
        server/postgres-seed.ts "--$MODE"
    then
        docker compose down --remove-orphans \
            || true
        exit 1
    fi
}

for arg in "$@"; do
    if [ "$arg" = '--help' ] || [ "$arg" = '-h' ]; then
        usage
        exit 0
    fi
done

if [ $# -eq 0 ]; then
    usage >&2
    exit 1
fi

PORT_ARG=''
MODE=''
COMMAND=''

while [ $# -gt 0 ]; do
    case "$1" in
        bundle)
            if [ -n "$COMMAND" ] \
                || [ -n "$PORT_ARG" ] \
                || [ -n "$MODE" ]; then
                usage >&2
                exit 1
            fi
            COMMAND=bundle
            shift
            ;;
        --postgres)
            if [ "$COMMAND" = bundle ]; then
                usage >&2
                exit 1
            fi
            if [ $# -lt 2 ]; then
                echo "Error: --postgres requires" \
                    "a value" >&2
                usage >&2
                exit 1
            fi
            case "$2" in
                mock-data|bootstrap)
                    MODE="$2"
                    ;;
                *)
                    echo "Error: --postgres must be" \
                        "mock-data or bootstrap" >&2
                    usage >&2
                    exit 1
                    ;;
            esac
            shift 2
            ;;
        *)
            if [ -n "$PORT_ARG" ] \
                || [ "$COMMAND" = bundle ]; then
                usage >&2
                exit 1
            fi
            PORT_ARG="$1"
            shift
            ;;
    esac
done

session_paths

if [ "$COMMAND" = bundle ]; then
    bundle_client "$SITE"
    exit 0
fi

if ! valid_port "$PORT_ARG"; then
    echo "Error: PORT must be an integer" \
        "1-65535" >&2
    usage >&2
    exit 1
fi

prepare_database
serve_site
