#!/bin/bash
# Edit session. Creates a fresh Postgres, seeds it,
# and serves. Source changes recompose the site.
# Exit, including Ctrl-C, takes the stack down.
set -euo pipefail

usage() {
    cat <<'USAGE'
Usage: ./bin/develop PORT --postgres mock-data|bootstrap

  PORT        Listen port. Required. No default.
  --postgres  How to seed the fresh database:
              mock-data or bootstrap. Required.

Creates a fresh Postgres, seeds it, and
serves. A change under web-app/, client/,
or shared/ recomposes the site; reload the
browser. Ctrl-C stops the server and runs:
  docker compose -p fusion-develop down

The site directory is $TMPDIR/fusion-develop
(FUSION_DEVELOP_DIR overrides it).
USAGE
}

valid_port() {
    case "$1" in
        [1-9]) ;;
        [1-9][0-9]) ;;
        [1-9][0-9][0-9]) ;;
        [1-9][0-9][0-9][0-9]) ;;
        [1-9][0-9][0-9][0-9][0-9]) ;;
        *) return 1 ;;
    esac
    [ "$1" -le 65535 ]
}

BIN="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$BIN/.." && pwd)"
cd "$ROOT"
# shellcheck source=build-lib
source "$BIN/build-lib"
# shellcheck source=compose-lib
source "$BIN/compose-lib"

ALLOW_ENV=POSTGRES_URL,PGPORT,PGSSL,PGSSLNEGOTIATION
ALLOW_ENV="$ALLOW_ENV,PGIDLE_TIMEOUT,PGCONNECT_TIMEOUT"
ALLOW_ENV="$ALLOW_ENV,PGMAX_LIFETIME,PGMAX_PIPELINE"
ALLOW_ENV="$ALLOW_ENV,PGBACKOFF,PGKEEP_ALIVE,PGPREPARE"
ALLOW_ENV="$ALLOW_ENV,PGDEBUG,PGFETCH_TYPES"
ALLOW_ENV="$ALLOW_ENV,PGPUBLICATIONS"
ALLOW_ENV="$ALLOW_ENV,PGTARGET_SESSION_ATTRS,PGAPPNAME"
ALLOW_ENV="$ALLOW_ENV,PGTARGETSESSIONATTRS"
ALLOW_ENV="$ALLOW_ENV,JWT_HMAC_SIGNING_KEY,PORT"
ALLOW_ENV="$ALLOW_ENV,TRUSTED_PROXY_HOPS"

CLEANED=''
WATCH_PID=''
LOOP_PID=''
SERVER_PID=''

session_paths() {
    SESSION_ROOT="${FUSION_DEVELOP_DIR:-}"
    if [ -z "$SESSION_ROOT" ]; then
        SESSION_ROOT="${TMPDIR:-/tmp}/fusion-develop"
    fi
    mkdir -p "$SESSION_ROOT"
    SESSION_ROOT="$(cd "$SESSION_ROOT" && pwd)"
    SITE="$SESSION_ROOT/site"
}

cleanup() {
    if [ -n "$CLEANED" ]; then
        return
    fi
    CLEANED=1
    if [ -n "$WATCH_PID" ]; then
        kill "$WATCH_PID" 2>/dev/null || true
        wait "$WATCH_PID" 2>/dev/null || true
    fi
    if [ -n "$LOOP_PID" ]; then
        kill "$LOOP_PID" 2>/dev/null || true
        wait "$LOOP_PID" 2>/dev/null || true
    fi
    if [ -n "$SERVER_PID" ]; then
        kill "$SERVER_PID" 2>/dev/null || true
        wait "$SERVER_PID" 2>/dev/null || true
    fi
    compose_down_once
    if [ -n "${SESSION_ROOT:-}" ]; then
        rm -rf "$SESSION_ROOT"
    fi
}

start_watcher() {
    local fifo="$SESSION_ROOT/watch.fifo"
    mkfifo "$fifo"
    while IFS= read -r _; do
        echo "Rebundling. Reload the browser." >&2
        bundle_client "$SITE" || true
    done < "$fifo" &
    LOOP_PID=$!
    deno run --frozen \
        --allow-read="$ROOT/web-app" \
        --allow-read="$ROOT/client" \
        --allow-read="$ROOT/shared" \
        server/develop-watch.ts \
        "$ROOT/web-app" \
        "$ROOT/client" \
        "$ROOT/shared" \
        > "$fifo" &
    WATCH_PID=$!
}

run_server() {
    deno run --frozen --allow-net \
        --allow-read="$SITE" \
        --allow-env="$ALLOW_ENV" \
        server/develop-main.ts "${SITE}/" &
    SERVER_PID=$!
    while kill -0 "$SERVER_PID" 2>/dev/null; do
        sleep 0.2
    done
    local status=0
    wait "$SERVER_PID" || status=$?
    exit "$status"
}

for arg in "$@"; do
    if [ "$arg" = '--help' ] || [ "$arg" = '-h' ]; then
        usage
        exit 0
    fi
done

if [ $# -eq 0 ]; then
    usage >&2
    exit 1
fi

PORT_ARG=''
MODE=''

while [ $# -gt 0 ]; do
    case "$1" in
        --postgres)
            if [ $# -lt 2 ]; then
                echo "Error: --postgres requires" \
                    "a value" >&2
                usage >&2
                exit 1
            fi
            case "$2" in
                mock-data|bootstrap)
                    MODE="$2"
                    ;;
                *)
                    echo "Error: --postgres must be" \
                        "mock-data or bootstrap" >&2
                    usage >&2
                    exit 1
                    ;;
            esac
            shift 2
            ;;
        *)
            if [ -n "$PORT_ARG" ]; then
                usage >&2
                exit 1
            fi
            PORT_ARG="$1"
            shift
            ;;
    esac
done

if ! valid_port "$PORT_ARG"; then
    echo "Error: PORT must be an integer" \
        "1-65535" >&2
    usage >&2
    exit 1
fi

if [ -z "$MODE" ]; then
    echo "Error: --postgres is required." >&2
    usage >&2
    exit 1
fi

export COMPOSE_PROJECT_NAME=fusion-develop
export PORT="$PORT_ARG"
mint_compose_env "$PORT_ARG"
session_paths
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
docker compose down --remove-orphans
docker compose up -d --wait postgres
if ! deno run --frozen --allow-net \
    --allow-env="$ALLOW_ENV" \
    server/postgres-seed.ts "--$MODE"
then
    exit 1
fi
bundle_client "$SITE"
start_watcher
echo
echo "Serving on http://localhost:$PORT/"
run_server
