#!/bin/bash
set -euo pipefail

# Page-load benchmark via headless Chrome + CDP.
# Flags: --check, --record, --write-budgets,
#   --budget-sigmas N, --pages a,b,c, --runs N,
#   --visualize (history HTML; bare = no Chrome),
#   --profile (API counts + page-init outside
#   fetch/render; defaults: 4 pages, 1 run),
#   --base-url URL (existing origin; skip spawn/seed),
#   --password SECRET (or MEASURE_PASSWORD),
#   --help / -h
#
# Permissions, named: read (the module graph, the Chrome
# binary, measurements/, Chrome's DevToolsActivePort);
# write (the temp build and Chrome-profile directories,
# plus budgets, history, and the visualizer HTML); net
# (the measured origin, Chrome's debug port, and the
# free-port probe); env granted per option. Help and
# bare --visualize read none. --base-url reads CHROME
# and MEASURE_PASSWORD. A local spawn reads CHROME,
# the signing key, and POSTGRES_URL.
#
# --allow-run is unscoped, as in ./bin/test-browser,
# because two of its targets are known only at run time:
# Chrome's path comes from CHROME, and ./fusion-angle is
# spawned with cwd set to a fresh mktemp directory —
# Deno checks a scoped entry against THIS process's cwd,
# where no such file exists. The rest of the list is git,
# ./bin/build, ./bin/postgres-seed, and the ps that
# killProcessTree walks.
BIN="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$BIN/.." && pwd)"
cd "$ROOT"

needs_help=false
needs_visualize=false
needs_extra=false
needs_base_url=false
for arg in "$@"; do
    case "$arg" in
        --help|-h)
            needs_help=true
            ;;
        --visualize)
            needs_visualize=true
            ;;
        --base-url)
            needs_base_url=true
            needs_extra=true
            ;;
        --check|--record|--write-budgets|--profile|--pages|--runs)
            needs_extra=true
            ;;
    esac
done

env_flag=""
if $needs_help \
    || { $needs_visualize && ! $needs_extra; }
then
    env_flag=""
elif $needs_base_url; then
    env_flag="--allow-env=CHROME,MEASURE_PASSWORD"
else
    env_flag="--allow-env=CHROME,JWT_HMAC_SIGNING_KEY,POSTGRES_URL"
fi

# shellcheck disable=SC2086
deno run --frozen \
    --allow-read \
    --allow-write="${TMPDIR:-/tmp}",measurements \
    --allow-net \
    --allow-run \
    $env_flag \
    web-app/app/measure.ts "$@"
