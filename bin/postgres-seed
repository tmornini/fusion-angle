#!/bin/bash
set -euo pipefail

BIN="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$BIN/.." && pwd)"
# shellcheck disable=SC1091
. "$BIN/postgres-lib"

usage() {
    cat <<'USAGE'
Usage: ./bin/postgres-seed --postgres local
       --bootstrap|--mock-data
       ./bin/postgres-seed --postgres render TOKEN
       --bootstrap|--mock-data

Seed an empty Postgres. --postgres is
required and has no default. --postgres render
needs TOKEN (the confirmation). --postgres local
is compose run of the seed service. It takes no
TOKEN.

Options:
  --postgres render|local   Target (required)
  --bootstrap   Seed bootstrap identities
  --mock-data   Seed mock data
  --help       Show this help message

render: TOKEN must see exactly one Postgres and
one web service. render CLI, not curl.
local: docker compose run --rm seed MODE.
Development gun.
USAGE
}

POSTGRES_TARGET=''
TOKEN=''
BOOTSTRAP=false
MOCK_DATA=false

while [ $# -gt 0 ]; do
    case "$1" in
        --help|-h)
            usage
            exit 0
            ;;
        --postgres)
            if [ $# -lt 2 ]; then
                echo "Error: --postgres requires" \
                    "a value" >&2
                usage >&2
                exit 1
            fi
            POSTGRES_TARGET="$2"
            shift 2
            ;;
        --bootstrap)
            BOOTSTRAP=true
            shift
            ;;
        --mock-data)
            MOCK_DATA=true
            shift
            ;;
        -*)
            echo "Error: unknown argument: $1" >&2
            usage >&2
            exit 1
            ;;
        *)
            if [ -n "$TOKEN" ]; then
                echo "Error: unexpected argument:" \
                    "$1" >&2
                usage >&2
                exit 1
            fi
            TOKEN="$1"
            shift
            ;;
    esac
done

MODE_COUNT=0
if [ "$BOOTSTRAP" = true ]; then
    MODE_COUNT=$((MODE_COUNT + 1))
fi
if [ "$MOCK_DATA" = true ]; then
    MODE_COUNT=$((MODE_COUNT + 1))
fi

if [ "$MODE_COUNT" -gt 1 ]; then
    echo "Error: --bootstrap and --mock-data are" \
        "exclusive" >&2
    usage >&2
    exit 1
fi

if [ "$MODE_COUNT" -eq 0 ]; then
    echo "Error: exactly one of --bootstrap or" \
        "--mock-data is required" >&2
    usage >&2
    exit 1
fi

case "$POSTGRES_TARGET" in
    '')
        echo "Error: --postgres is required" >&2
        usage >&2
        exit 1
        ;;
    render|local)
        ;;
    *)
        echo "Error: --postgres must be render" \
            "or local" >&2
        usage >&2
        exit 1
        ;;
esac

if [ "$POSTGRES_TARGET" = "render" ] \
    && [ -z "$TOKEN" ]; then
    echo "Error: TOKEN is required" >&2
    usage >&2
    exit 1
fi

if [ "$POSTGRES_TARGET" = "local" ] \
    && [ -n "$TOKEN" ]; then
    echo "Error: unexpected argument" >&2
    usage >&2
    exit 1
fi

if [ "$BOOTSTRAP" = true ]; then
    MODE='--bootstrap'
else
    MODE='--mock-data'
fi

if [ "$POSTGRES_TARGET" = "local" ]; then
    if ! command -v docker >/dev/null; then
        echo "Error: docker is required" >&2
        exit 1
    fi
    exec docker compose -f "$ROOT/compose.yaml" \
        run --rm seed "$MODE"
fi

if ! command -v deno >/dev/null; then
    echo "Error: deno is required" >&2
    exit 1
fi

export RENDER_API_KEY="$TOKEN"
unset TOKEN
assert_render_cli

cleanup() {
    rm -rf "$TMP"
}

TMP=$(mktemp -d \
    "${TMPDIR:-/tmp}/fusion-seed.XXXXXX")
trap cleanup EXIT

discover_render_ids

render jobs create "$SERVICE_ID" \
    --start-command \
    "./render-out/fusion-angle seed ${MODE}" \
    --confirm -o json > "$TMP/seed-created.json"

JOB_ID=$(job_id_from \
    "$TMP/seed-created.json" seed)
SEED_START=$(start_rfc3339)
wait_for_job "$JOB_ID" "$REVEAL_TIMEOUT_SEC" seed

render logs --resources "$JOB_ID" \
    --start "$SEED_START" \
    --direction forward --limit 100 \
    -o json > "$TMP/logs.json"
flatten_render_logs "$TMP/logs.json" \
    "$TMP/logs.txt"
print_reveal_lines "$TMP/logs.txt"

render restart "$SERVICE_ID" --confirm \
    -o json > "$TMP/restart.json"

echo "Revoke the API key at ${DASHBOARD_KEYS}" >&2
exit 0
