#!/bin/bash
set -euo pipefail

usage() {
    cat <<'USAGE'
Usage: ./bin/build [--no-zip] [path/]

Options:
  path/      Output directory (trailing / required)
             Default: ~/Desktop/
  --no-zip   Create bundle directory without zipping
             (the fusion-angle executable — for ./bin/deploy)
  --help     Show this help message

Examples:
  ./bin/build                      # server ZIP to ~/Desktop/
  ./bin/build dist/                # server ZIP to dist/
  ./bin/build --no-zip /tmp/test/  # server bundle to /tmp/test/
  ./bin/build --no-zip             # mktemp dir; prints Bundle:
USAGE
}

NO_ZIP=false
DEST=""

for arg in "$@"; do
    case "$arg" in
        --help|-h) usage; exit 0 ;;
        --no-zip)  NO_ZIP=true ;;
        */)        DEST="$arg" ;;
        *)
            echo "Error: unknown argument: $arg" >&2
            usage >&2
            exit 1
            ;;
    esac
done

BIN="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$BIN/.." && pwd)"
# shellcheck source=build-lib
source "$BIN/build-lib"
# shellcheck source=sha-result-cache-lib
source "$BIN/sha-result-cache-lib"
# shellcheck source=duration-lib
source "$BIN/duration-lib"
# shellcheck source=clean-tree-lib
source "$BIN/clean-tree-lib"
# git, bundle_client, compile: cwd must be ROOT
cd "$ROOT"

# An image build may hold no repository: Render deletes
# .git, and a worktree's .git names a directory the image
# lacks. There is no tree to ask about there, and the
# commit is named by a build argument below. Wherever git
# finds a repository, its tree must be clean.
if git rev-parse --git-dir > /dev/null 2>&1; then
    require_clean_tree
fi

# A checkout embeds the commit log of git rev-parse HEAD.
# A local Docker build may hold only a worktree's .git
# pointer: compose passes the host's log as
# FUSION_COMMIT_LOG_BASE64 instead. Render deletes .git
# and passes RENDER_GIT_COMMIT and RENDER_GIT_REPO_SLUG
# as build args: the build fetches that commit from the
# public repository and reads the log from it.
GIT_SHA="$(git rev-parse HEAD 2>/dev/null || true)"
if [[ "$GIT_SHA" =~ ^[0-9a-f]{40}$ ]]; then
    COMMIT_LOG="$(commit_log . "$GIT_SHA")"
elif [ -n "${FUSION_COMMIT_LOG_BASE64:-}" ]; then
    if ! COMMIT_LOG="$(decoded_commit_log \
        "$FUSION_COMMIT_LOG_BASE64")"
    then
        echo "Error: FUSION_COMMIT_LOG_BASE64 is not" \
            "a commit log." >&2
        exit 1
    fi
else
    if [[ ! "${RENDER_GIT_COMMIT:-}" =~ ^[0-9a-f]{40}$ ]]
    then
        echo "Error: no commit SHA to embed." \
            "git rev-parse HEAD failed," \
            "FUSION_COMMIT_LOG_BASE64 is empty, and" \
            "RENDER_GIT_COMMIT is not 40 lowercase hex." \
            >&2
        exit 1
    fi
    if [ -z "${RENDER_GIT_REPO_SLUG:-}" ]; then
        echo "Error: no repository to fetch" \
            "RENDER_GIT_COMMIT from." \
            "RENDER_GIT_REPO_SLUG is empty." >&2
        exit 1
    fi
    # The log is what fetched_commit prints, and nothing
    # else: its first line must name the sha asked for.
    if ! COMMIT_LOG="$(fetched_commit \
        "https://github.com/${RENDER_GIT_REPO_SLUG}.git" \
        "$RENDER_GIT_COMMIT")" \
        || [ "${COMMIT_LOG%% *}" != "$RENDER_GIT_COMMIT" ]
    then
        echo "Error: commit $RENDER_GIT_COMMIT not fetched" \
            "from $RENDER_GIT_REPO_SLUG on GitHub." >&2
        exit 1
    fi
fi

# A commit message is arbitrary text: the entry carries
# the log as one line of base64, never as source. GNU
# base64 wraps at 76 columns.
COMMIT_LOG_BASE64="$(printf '%s' "$COMMIT_LOG" | base64 | tr -d '\n')"

build() {
    echo "Building Fusion Angle..."

    if [ "$NO_ZIP" = true ] && [ -n "$DEST" ]; then
        BUILD_DIR="$DEST"
        mkdir -p "$BUILD_DIR"
    elif [ "$NO_ZIP" = true ]; then
        BUILD_DIR=$(mktemp -d "${TMPDIR:-/tmp}/fusion-build.XXXXXX")
    else
        BUILD_DIR=$(mktemp -d "${TMPDIR:-/tmp}/fusion-build.XXXXXX")
        trap 'rm -rf "$BUILD_DIR"' EXIT
    fi

    bundle_client "$BUILD_DIR/site"

    if [ "$NO_ZIP" = true ]; then
        TARGET_FLAG=""
    else
        TARGET_FLAG="--target x86_64-unknown-linux-gnu"
    fi

    ABS_BUILD="$(cd "$BUILD_DIR" && pwd)"
    # deno compile looks up absolute file:// specifiers on
    # disk at runtime, so the generated entry must be
    # relative for the binary to run without the source tree.
    SERVER_IMPORT=$(
        printf '%s' '
            import { relative } from "@std/path/posix";
            let rel = relative(
                Deno.args[0],
                Deno.args[1],
            );
            if (!rel.startsWith(".")) rel = "./" + rel;
            console.log(rel);
        ' | deno run --frozen --config "$ROOT/deno.json" \
            - "$ABS_BUILD" "$ROOT/server/main.ts"
    )
    cat > "$BUILD_DIR/main.ts" <<ENTRY
import { dispatch, embeddedCommit } from '${SERVER_IMPORT}';
Deno.exit(await dispatch(
    new URL('./site/', import.meta.url),
    Deno.args,
    embeddedCommit('${COMMIT_LOG_BASE64}'),
));
ENTRY

    deno compile --frozen --exclude-unused-npm \
        --config "$ROOT/deno.json" \
        --include "$BUILD_DIR/site" \
        --allow-net \
        --allow-env=POSTGRES_URL,PGPORT,PGSSL,PGSSLNEGOTIATION,\
PGIDLE_TIMEOUT,PGCONNECT_TIMEOUT,PGMAX_LIFETIME,PGMAX_PIPELINE,PGBACKOFF,\
PGKEEP_ALIVE,PGPREPARE,PGDEBUG,PGFETCH_TYPES,PGPUBLICATIONS,\
PGTARGET_SESSION_ATTRS,PGAPPNAME,PGTARGETSESSIONATTRS,\
PGSSLMODE,PGCHANNELBINDING,PGCHANNEL_BINDING,PGMIN,\
PGQUEUE_TIMEOUT,PGQUERY_TIMEOUT,PGCANCEL_TIMEOUT,\
PGSCHEDULER,PGINFER,PGSLOT,\
JWT_HMAC_SIGNING_KEY,PORT,TRUSTED_PROXY_HOPS \
        ${TARGET_FLAG} \
        -o "$BUILD_DIR/fusion-angle" \
        "$BUILD_DIR/main.ts"

    emitted "Executable created" "$BUILD_DIR/fusion-angle"

    if [ "$NO_ZIP" = true ]; then
        echo "Bundle: $BUILD_DIR"
    else
        (cd "$BUILD_DIR" && zip -r "$SERVER_ZIP" .)
        echo "Distribution: $SERVER_ZIP" \
            "($(wc -c < "$SERVER_ZIP" | xargs) bytes)"
    fi
    echo "Done."
}

if [ "$NO_ZIP" = true ]; then
    # Measured under the five-second line, so it builds
    # every time; the image build and the measure sweep
    # use this form and never meet the result cache.
    timed './bin/build --no-zip' build
else
    # A ZIP that passed on this SHA replays instead of
    # building again, once the file at its path proves
    # to hold the bytes that build left. The timer is
    # inside the ask, so a replay is never a sample.
    SHA=$(git rev-parse --short=7 HEAD)
    DEST_DIR="${DEST:-$HOME/Desktop/}"
    SERVER_ZIP="${DEST_DIR}fusion-angle-${SHA}.zip"
    replay_or_run build "$SERVER_ZIP" -- timed './bin/build' build
fi
