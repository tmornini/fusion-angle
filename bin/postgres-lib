# Shared Render/local helpers for postgres-seed
# and postgres-wipe. Source me; do not exec.

API='https://api.render.com/v1'
WIPE_TIMEOUT_SEC=120
REVEAL_TIMEOUT_SEC=180
POLL_SEC=5
REVEAL_HEADER='Save your demo sign-ins — shown once; copy them now.'
DASHBOARD_KEYS='https://dashboard.render.com/u/settings?add-api-key'

fail_http() {
    local code="$1"
    local file="$2"
    local msg
    msg=$(printf '%s' '
        const enc = new TextEncoder();
        const path = Deno.args[0];
        let msg = "";
        try {
            const raw = Deno.readTextFileSync(path);
            const json = JSON.parse(raw);
            if (
                json
                && typeof json.message === "string"
            ) {
                msg = json.message;
            }
        } catch {
            msg = "";
        }
        Deno.stdout.writeSync(enc.encode(msg));
    ' | deno run --frozen --allow-read="$file" - "$file")
    if [ -n "$msg" ]; then
        echo "Error: Render HTTP ${code}: ${msg}" >&2
    else
        echo "Error: Render HTTP ${code}" >&2
    fi
    exit 1
}

# $1 method  $2 path  $3 outfile  $4 optional JSON body
http_json() {
    local method="$1"
    local path="$2"
    local out="$3"
    local body="${4:-}"
    local code
    local -a curl_args=(
        -sS
        -o "$out"
        -w '%{http_code}'
        -X "$method"
        -H "Authorization: Bearer ${RENDER_API_KEY}"
        -H "Accept: application/json"
    )
    if [ -n "$body" ]; then
        curl_args+=(
            -H "Content-Type: application/json"
            --data-binary @"$body"
        )
    fi
    code=$(curl "${curl_args[@]}" "${API}${path}")
    case "$code" in
        2??) return 0 ;;
        *) fail_http "$code" "$out" ;;
    esac
}

write_job_body() {
    local dest="$1"
    local cmd="$2"
    printf '%s' '
        Deno.writeTextFileSync(
            Deno.args[0],
            JSON.stringify({
                startCommand: Deno.args[1],
            }),
        );
    ' | deno run --frozen --allow-write="$dest" - "$dest" "$cmd"
}

start_rfc3339() {
    if date -u -v-5S +'%Y-%m-%dT%H:%M:%SZ' \
        >/dev/null 2>&1; then
        date -u -v-5S +'%Y-%m-%dT%H:%M:%SZ'
        return
    fi
    date -u -d '5 seconds ago' \
        +'%Y-%m-%dT%H:%M:%SZ'
}

fetch_logs() {
    local owner="$1"
    local resource="$2"
    local start="$3"
    local out="$4"
    local code
    code=$(curl -sS -o "$out" -w '%{http_code}' \
        --get \
        --data-urlencode "ownerId=${owner}" \
        --data-urlencode "resource=${resource}" \
        --data-urlencode "startTime=${start}" \
        --data-urlencode "limit=100" \
        --data-urlencode "direction=forward" \
        -H "Authorization: Bearer ${RENDER_API_KEY}" \
        -H "Accept: application/json" \
        "${API}/logs")
    case "$code" in
        2??) return 0 ;;
        *) fail_http "$code" "$out" ;;
    esac
}

# Flatten Render logs JSON to one text line per
# logs[].message, splitting each message on \n.
flatten_render_logs() {
    local src="$1"
    local dest="$2"
    printf '%s' '
        const data = JSON.parse(
            Deno.readTextFileSync(Deno.args[0]),
        );
        const logs = Array.isArray(data.logs)
            ? data.logs
            : [];
        const lines = [];
        for (const entry of logs) {
            const message = entry && entry.message;
            const text = typeof message === "string"
                ? message
                : "";
            for (const line of text.split("\n")) {
                lines.push(line);
            }
        }
        Deno.writeTextFileSync(
            Deno.args[1],
            lines.join("\n"),
        );
    ' | deno run --frozen \
        --allow-read="$src" --allow-write="$dest" - "$src" "$dest"
}

# Print the reveal from the header through the last
# tab-bearing line. Exit 10 if the header is
# absent. Exit 11 if the header is present but no
# tab-bearing line follows it.
print_reveal_lines() {
    local file="$1"
    printf '%s' '
        const enc = new TextEncoder();
        const header = Deno.args[1];
        const text = Deno.readTextFileSync(Deno.args[0]);
        const lines = text.split("\n");
        const idx = lines.findIndex(
            (line) => line.includes(header),
        );
        if (idx < 0) Deno.exit(10);
        let lastTab = -1;
        for (let i = idx + 1; i < lines.length;
            i++) {
            if (lines[i].includes("\t")) {
                lastTab = i;
            }
        }
        if (lastTab < 0) Deno.exit(11);
        const out = lines.slice(idx, lastTab + 1)
            .join("\n") + "\n";
        Deno.stdout.writeSync(enc.encode(out));
    ' | deno run --frozen --allow-read="$file" \
        - "$file" "$REVEAL_HEADER"
}

assert_loopback_postgres_url() {
    if [ -z "${POSTGRES_URL:-}" ]; then
        echo "Error: missing required env" \
            "POSTGRES_URL" >&2
        exit 1
    fi
    local host
    host=$(printf '%s' '
        const enc = new TextEncoder();
        const url = Deno.env.get("POSTGRES_URL")
            ?? "";
        if (url === "") Deno.exit(2);
        try {
            Deno.stdout.writeSync(enc.encode(
                new URL(url).hostname,
            ));
        } catch {
            Deno.exit(3);
        }
    ' | deno run --frozen --allow-env=POSTGRES_URL -) || {
        echo "Error: POSTGRES_URL host is not" \
            "loopback" >&2
        exit 1
    }
    case "$host" in
        localhost|127.0.0.1|'[::1]')
            ;;
        *)
            echo "Error: POSTGRES_URL host is" \
            "not loopback" >&2
            exit 1
            ;;
    esac
}

job_id_from() {
    local file="$1"
    local label="$2"
    printf '%s' '
        const enc = new TextEncoder();
        const job = JSON.parse(
            Deno.readTextFileSync(Deno.args[0]),
        );
        if (typeof job.id !== "string"
            || job.id === "") {
            Deno.stderr.writeSync(enc.encode(
                "Error: "
                + Deno.args[1]
                + " job id missing\n",
            ));
            Deno.exit(1);
        }
        Deno.stdout.writeSync(enc.encode(job.id));
    ' | deno run --frozen --allow-read="$file" - "$file" "$label"
}

job_status_from() {
    local file="$1"
    printf '%s' '
        const enc = new TextEncoder();
        const job = JSON.parse(
            Deno.readTextFileSync(Deno.args[0]),
        );
        Deno.stdout.writeSync(enc.encode(
            typeof job.status === "string"
                ? job.status
                : "",
        ));
    ' | deno run --frozen --allow-read="$file" - "$file"
}

wait_for_job() {
    local job_id="$1"
    local timeout_sec="$2"
    local label="$3"
    local started=$SECONDS
    local status=''
    while [ $((SECONDS - started)) -lt \
        "$timeout_sec" ]; do
        http_json GET \
            "/services/${SERVICE_ID}/jobs/${job_id}" \
            "$TMP/${label}-status.json"
        status=$(job_status_from \
            "$TMP/${label}-status.json")
        case "$status" in
            succeeded)
                return 0
                ;;
            failed|canceled)
                echo "Error: ${label} job" \
                    "${job_id} ${status}" >&2
                exit 1
                ;;
        esac
        sleep "$POLL_SEC"
    done
    echo "Error: ${label} job ${job_id}" \
        "timed out (${status:-pending})" >&2
    exit 1
}

discover_render_ids() {
    http_json GET '/postgres?limit=100' \
        "$TMP/postgres.json"
    http_json GET \
        '/services?type=web_service&limit=100' \
        "$TMP/services.json"

    printf '%s' '
        const enc = new TextEncoder();

        function load(path) {
            const json = JSON.parse(
                Deno.readTextFileSync(path),
            );
            if (!Array.isArray(json)) {
                Deno.stderr.writeSync(enc.encode(
                    "Error: Render list is not an array\n",
                ));
                Deno.exit(1);
            }
            return json;
        }

        function refuse(kind, lines) {
            Deno.stderr.writeSync(enc.encode(
                "Error: expected exactly one "
                + kind
                + ", found "
                + String(lines.length)
                + "\n",
            ));
            for (const line of lines) {
                Deno.stderr.writeSync(
                    enc.encode("  " + line + "\n"),
                );
            }
            Deno.exit(1);
        }

        const postgres = load(Deno.args[0]);
        const services = load(Deno.args[1]);
        const pgLines = postgres.map((row) => {
            const item = row && row.postgres;
            const name = item && item.name;
            const id = item && item.id;
            return String(name ?? "?")
                + " ("
                + String(id ?? "?")
                + ")";
        });
        const svcLines = services.map((row) => {
            const item = row && row.service;
            const name = item && item.name;
            const id = item && item.id;
            return String(name ?? "?")
                + " ("
                + String(id ?? "?")
                + ")";
        });
        if (postgres.length !== 1) {
            refuse("Postgres instance", pgLines);
        }
        if (services.length !== 1) {
            refuse("web service", svcLines);
        }
        const owner = postgres[0].postgres
            && postgres[0].postgres.owner
            && postgres[0].postgres.owner.id;
        const serviceId = services[0].service
            && services[0].service.id;
        if (typeof owner !== "string" || owner === "") {
            Deno.stderr.writeSync(enc.encode(
                "Error: Postgres owner id missing\n",
            ));
            Deno.exit(1);
        }
        if (typeof serviceId !== "string"
            || serviceId === "") {
            Deno.stderr.writeSync(enc.encode(
                "Error: web service id missing\n",
            ));
            Deno.exit(1);
        }
        Deno.stdout.writeSync(
            enc.encode(owner + "\n" + serviceId + "\n"),
        );
    ' | deno run --frozen \
        --allow-read="$TMP/postgres.json" \
        --allow-read="$TMP/services.json" \
        - "$TMP/postgres.json" "$TMP/services.json" \
        > "$TMP/ids.txt"

    OWNER_ID=$(sed -n '1p' "$TMP/ids.txt")
    SERVICE_ID=$(sed -n '2p' "$TMP/ids.txt")
}
