# Shared Render/local helpers for postgres-seed
# and postgres-wipe. Source me; do not exec.

WIPE_TIMEOUT_SEC=120
REVEAL_TIMEOUT_SEC=180
POLL_SEC=5
REVEAL_HEADER='Save your demo sign-ins — shown once; copy them now.'
DASHBOARD_KEYS='https://dashboard.render.com/u/settings?add-api-key'

assert_render_cli() {
    if ! command -v render >/dev/null; then
        echo "Error: render is required" >&2
        exit 1
    fi
    local yaml="$HOME/.render/cli.yaml"
    if [ ! -f "$yaml" ]; then
        echo "Error: ~/.render/cli.yaml is" \
            "required" >&2
        exit 1
    fi
    printf '%s' '
        const enc = new TextEncoder();
        const text = Deno.readTextFileSync(
            Deno.args[0],
        );
        const match = text.match(
            /expires_at:\s*"?([0-9T:.\-]+Z)/,
        );
        if (!match) {
            Deno.stderr.writeSync(enc.encode(
                "Error: ~/.render/cli.yaml is expired\n",
            ));
            Deno.exit(1);
        }
        const exp = Date.parse(match[1]);
        if (!Number.isFinite(exp)
            || Date.now() >= exp) {
            Deno.stderr.writeSync(enc.encode(
                "Error: ~/.render/cli.yaml is expired\n",
            ));
            Deno.exit(1);
        }
    ' | deno run --frozen --allow-read="$yaml" \
        - "$yaml"
}

start_rfc3339() {
    if date -u -v-5S +'%Y-%m-%dT%H:%M:%SZ' \
        >/dev/null 2>&1; then
        date -u -v-5S +'%Y-%m-%dT%H:%M:%SZ'
        return
    fi
    date -u -d '5 seconds ago' \
        +'%Y-%m-%dT%H:%M:%SZ'
}

# Flatten CLI log JSON to one text line per
# message, splitting each message on \n.
# STOP if no message field can be found.
flatten_render_logs() {
    local src="$1"
    local dest="$2"
    printf '%s' '
        const enc = new TextEncoder();
        const text = Deno.readTextFileSync(
            Deno.args[0],
        );
        function parseAll(raw) {
            try {
                return JSON.parse(raw);
            } catch {
                const wrapped = "["
                    + raw.replace(/}\s*{/g, "},{")
                    + "]";
                try {
                    return JSON.parse(wrapped);
                } catch {
                    return null;
                }
            }
        }
        const data = parseAll(text);
        if (data === null) {
            Deno.stderr.writeSync(enc.encode(
                "Error: log messages missing\n",
            ));
            Deno.exit(1);
        }
        const messages = [];
        function walk(value) {
            if (typeof value === "string") {
                return;
            }
            if (Array.isArray(value)) {
                for (const item of value) {
                    walk(item);
                }
                return;
            }
            if (value && typeof value === "object") {
                if (typeof value.message === "string") {
                    messages.push(value.message);
                    return;
                }
                for (const nested of Object.values(
                    value,
                )) {
                    walk(nested);
                }
            }
        }
        walk(data);
        if (messages.length === 0) {
            Deno.stderr.writeSync(enc.encode(
                "Error: log messages missing\n",
            ));
            Deno.exit(1);
        }
        const lines = [];
        for (const message of messages) {
            for (const line of message.split("\n")) {
                lines.push(line);
            }
        }
        Deno.writeTextFileSync(
            Deno.args[1],
            lines.join("\n"),
        );
    ' | deno run --frozen \
        --allow-read="$src" --allow-write="$dest" \
        - "$src" "$dest"
}

# Print the reveal from the header through the last
# tab-bearing line. Exit 10 if the header is
# absent. Exit 11 if the header is present but no
# tab-bearing line follows it.
print_reveal_lines() {
    local file="$1"
    printf '%s' '
        const enc = new TextEncoder();
        const header = Deno.args[1];
        const text = Deno.readTextFileSync(Deno.args[0]);
        const lines = text.split("\n");
        const idx = lines.findIndex(
            (line) => line.includes(header),
        );
        if (idx < 0) Deno.exit(10);
        let lastTab = -1;
        for (let i = idx + 1; i < lines.length;
            i++) {
            if (lines[i].includes("\t")) {
                lastTab = i;
            }
        }
        if (lastTab < 0) Deno.exit(11);
        const out = lines.slice(idx, lastTab + 1)
            .join("\n") + "\n";
        Deno.stdout.writeSync(enc.encode(out));
    ' | deno run --frozen --allow-read="$file" \
        - "$file" "$REVEAL_HEADER"
}

job_id_from() {
    local file="$1"
    local label="$2"
    printf '%s' '
        const enc = new TextEncoder();
        const job = JSON.parse(
            Deno.readTextFileSync(Deno.args[0]),
        );
        function idOf(value) {
            if (value && typeof value.id === "string"
                && value.id !== "") {
                return value.id;
            }
            if (value && value.job
                && typeof value.job === "object") {
                return idOf(value.job);
            }
            return "";
        }
        const id = idOf(job);
        if (id === "") {
            Deno.stderr.writeSync(enc.encode(
                "Error: "
                + Deno.args[1]
                + " job id missing\n",
            ));
            Deno.exit(1);
        }
        Deno.stdout.writeSync(enc.encode(id));
    ' | deno run --frozen --allow-read="$file" \
        - "$file" "$label"
}

job_status_from_list() {
    local file="$1"
    local job_id="$2"
    printf '%s' '
        const enc = new TextEncoder();
        const cannotPoll =
            "Error: render jobs get is not a CLI "
            + "verb; list cannot poll\n";
        function failPoll() {
            Deno.stderr.writeSync(
                enc.encode(cannotPoll),
            );
            Deno.exit(1);
        }
        let json;
        try {
            json = JSON.parse(
                Deno.readTextFileSync(Deno.args[0]),
            );
        } catch {
            failPoll();
        }
        function asList(value) {
            if (Array.isArray(value)) return value;
            if (value && typeof value === "object") {
                if (Array.isArray(value.data)) {
                    return value.data;
                }
                if (Array.isArray(value.jobs)) {
                    return value.jobs;
                }
            }
            return null;
        }
        function asJob(row) {
            if (row && row.job
                && typeof row.job === "object") {
                return row.job;
            }
            return row;
        }
        const rows = asList(json);
        if (rows === null) failPoll();
        const want = Deno.args[1];
        for (const row of rows) {
            const job = asJob(row);
            if (!job || job.id !== want) continue;
            if (typeof job.status !== "string") {
                failPoll();
            }
            Deno.stdout.writeSync(
                enc.encode(job.status),
            );
            Deno.exit(0);
        }
        Deno.exit(0);
    ' | deno run --frozen --allow-read="$file" \
        - "$file" "$job_id"
}

wait_for_job() {
    local job_id="$1"
    local timeout_sec="$2"
    local label="$3"
    local started=$SECONDS
    local status=''
    while [ $((SECONDS - started)) -lt \
        "$timeout_sec" ]; do
        render jobs list "$SERVICE_ID" -o json \
            > "$TMP/${label}-status.json"
        status=$(job_status_from_list \
            "$TMP/${label}-status.json" \
            "$job_id") || exit 1
        case "$status" in
            succeeded)
                return 0
                ;;
            failed|canceled)
                echo "Error: ${label} job" \
                    "${job_id} ${status}" >&2
                exit 1
                ;;
        esac
        sleep "$POLL_SEC"
    done
    echo "Error: ${label} job ${job_id}" \
        "timed out (${status:-pending})" >&2
    exit 1
}

discover_render_ids() {
    render postgres list -o json \
        > "$TMP/postgres.json"
    render services -o json \
        > "$TMP/services.json"

    printf '%s' '
        const enc = new TextEncoder();

        function fail(msg) {
            Deno.stderr.writeSync(enc.encode(
                "Error: " + msg + "\n",
            ));
            Deno.exit(1);
        }

        function load(path) {
            try {
                return JSON.parse(
                    Deno.readTextFileSync(path),
                );
            } catch {
                fail("Render list is not JSON");
            }
        }

        function asList(json) {
            if (Array.isArray(json)) return json;
            if (json && typeof json === "object") {
                const arrays = Object.values(json)
                    .filter(Array.isArray);
                if (arrays.length === 1) {
                    return arrays[0];
                }
                if (typeof json.id === "string") {
                    return [json];
                }
            }
            fail("Render list is not an array");
        }

        function unwrap(row, key) {
            if (row && row[key]
                && typeof row[key] === "object") {
                return row[key];
            }
            return row && typeof row === "object"
                ? row
                : {};
        }

        function str(value) {
            return typeof value === "string"
                ? value
                : "";
        }

        function refuse(kind, lines) {
            Deno.stderr.writeSync(enc.encode(
                "Error: expected exactly one "
                + kind
                + ", found "
                + String(lines.length)
                + "\n",
            ));
            for (const line of lines) {
                Deno.stderr.writeSync(
                    enc.encode("  " + line + "\n"),
                );
            }
            Deno.exit(1);
        }

        function lineOf(item) {
            return (str(item.name) || "?")
                + " ("
                + (str(item.id) || "?")
                + ")";
        }

        function ownerOf(item) {
            if (str(item.ownerId)) {
                return item.ownerId;
            }
            if (item.owner
                && typeof item.owner === "object") {
                return str(item.owner.id);
            }
            return str(item.owner);
        }

        function runtimeOf(item) {
            if (typeof item.runtime === "string") {
                return item.runtime;
            }
            const details = item.serviceDetails;
            if (details
                && typeof details.runtime === "string") {
                return details.runtime;
            }
            return null;
        }

        function isWeb(item) {
            const t = str(item.type);
            return t === "web_service" || t === "web";
        }

        const postgres = asList(load(Deno.args[0]))
            .map((row) => unwrap(row, "postgres"));
        const services = asList(load(Deno.args[1]))
            .map((row) => unwrap(row, "service"));
        const web = services.filter(isWeb);
        const pgLines = postgres.map(lineOf);
        const webLines = web.map(lineOf);
        if (postgres.length !== 1) {
            refuse("Postgres instance", pgLines);
        }
        if (web.length === 0
            && services.length > 0
            && services.every((item) =>
                str(item.type) === ""
            )) {
            fail("service type missing");
        }
        if (web.length !== 1) {
            refuse("web service", webLines);
        }
        const pg = postgres[0];
        const svc = web[0];
        const owner = ownerOf(pg);
        const serviceId = str(svc.id);
        if (owner === "") {
            fail("Postgres owner id missing");
        }
        if (serviceId === "") {
            fail("web service id missing");
        }
        const runtime = runtimeOf(svc);
        if (runtime === null) {
            fail("service runtime missing");
        }
        if (runtime !== "docker") {
            fail(
                "service runtime is "
                + runtime
                + ", not docker",
            );
        }
        Deno.stdout.writeSync(
            enc.encode(owner + "\n" + serviceId + "\n"),
        );
    ' | deno run --frozen \
        --allow-read="$TMP/postgres.json" \
        --allow-read="$TMP/services.json" \
        - "$TMP/postgres.json" "$TMP/services.json" \
        > "$TMP/ids.txt"

    OWNER_ID=$(sed -n '1p' "$TMP/ids.txt")
    SERVICE_ID=$(sed -n '2p' "$TMP/ids.txt")
}
