#!/bin/bash
# Sourced by ./build and ./test-browser from the repo
# root. Not a command. bundle_client composes the pages
# and bundles the client into DEST; ./build owns the
# clean-tree gate, server.mjs, and the ZIP.

# Fail when the artifact is empty or absent; report its
# size otherwise — one voice for every emitted artifact.
emitted() {
    local label="$1" artifact="$2"
    local name
    name=$(basename "$artifact")
    if [ ! -s "$artifact" ]; then
        echo "ERROR: $name is empty or missing" >&2
        exit 1
    fi
    echo "$label: assets/$name" \
        "($(wc -c < "$artifact" | xargs) bytes)"
}

bundle_client() {
    local dest="$1"
    node --strip-types web-app/app/compose.ts "$dest"

    mkdir -p "$dest/assets"
    npx --no-install esbuild \
        web-app/app/server-core.ts \
        --bundle \
        --minify \
        --keep-names \
        --target=es2024 \
        --format=iife \
        --outfile="$dest/assets/app.js"

    emitted "Server bundle created" \
        "$dest/assets/app.js"

    # Pre-app bootstrap scripts: extracted from former inline
    # <script> blocks so the page can run with a strict
    # Content-Security-Policy (script-src 'self').
    npx --no-install esbuild web-app/app/theme-init.ts \
        --bundle \
        --minify \
        --target=es2024 \
        --format=iife \
        --outfile="$dest/assets/theme-init.js"

    emitted "Bundle created" "$dest/assets/theme-init.js"

    npx --no-install esbuild web-app/app/root-redirect.ts \
        --bundle \
        --minify \
        --target=es2024 \
        --format=iife \
        --outfile="$dest/assets/root-redirect.js"

    emitted "Bundle created" "$dest/assets/root-redirect.js"

    cat web-app/app/styles/tokens.css \
        web-app/app/styles/fonts.css \
        web-app/app/styles/light-mode.css \
        web-app/app/styles/dark-mode.css \
        web-app/app/styles/base.css \
        web-app/app/styles/components-*.css \
        web-app/app/styles/layout.css \
        web-app/app/styles/utilities.css \
        web-app/app/styles/responsive.css \
        web-app/app/styles/command-palette.css \
        | npx --no-install esbuild --loader=css --minify \
        > "$dest/assets/styles.css"

    emitted "Styles created" "$dest/assets/styles.css"

    for f in web-app/app/styles/pages-*.css; do
        [ -f "$f" ] || continue
        name=$(basename "$f" .css)
        npx --no-install esbuild --minify "$f" \
            --outfile="$dest/assets/$name.css"
        emitted "Styles created" "$dest/assets/$name.css"
    done
    cp web-app/assets/*.woff2 "$dest/assets/"
    cp web-app/index.html "$dest/"
    cp web-app/assets/favicon.ico "$dest/assets/"
    cp web-app/assets/favicon.svg "$dest/assets/"
    cp web-app/assets/mark.png "$dest/assets/"
}
