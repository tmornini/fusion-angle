#!/bin/bash
set -euo pipefail

# Layer 2: deterministic browser tests. Bundles the
# client into $TMPDIR (any tree), then runs
# tests/browser/*.test.ts serially against an
# in-process origin on the memory backend. Needs
# Chrome: CHROME (binary) or CHROME_DEBUG_URL (a
# running Chrome's browser WebSocket URL).

ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "$ROOT"

# shellcheck source=build-lib
source ./build-lib

if [ -z "${CHROME_DEBUG_URL:-}" ]; then
    CHROME="${CHROME:-/Applications/Google Chrome.app}"
    CHROME="${CHROME%/}"
    if [ -d "$CHROME" ]; then
        CHROME="$CHROME/Contents/MacOS/Google Chrome"
    fi
    if [ ! -x "$CHROME" ]; then
        echo "Error: Chrome not found; set CHROME to" \
            "the binary or CHROME_DEBUG_URL to a" \
            "running Chrome" >&2
        exit 1
    fi
    export CHROME
fi

export JWT_HMAC_SIGNING_KEY="${JWT_HMAC_SIGNING_KEY:-test-hmac-signing-key}"

BUNDLE="$(mktemp -d "${TMPDIR:-/tmp}/fusion-browser.XXXXXX")"
trap 'rm -rf "$BUNDLE"' EXIT
bundle_client "$BUNDLE" > /dev/null
export FUSION_ANGLE_STATIC_ROOT="$BUNDLE"

# Per-test bound lives in tests/browser/fixtures.ts
# (withTimeout). deno test has no per-test timeout flag.
# --allow-env is unscoped: Chrome spawn copies the env bag.
# Resources only, no --sanitize-ops: useBrowser() opens the
# CDP WebSocket once per file in Deno.test.beforeAll, so its
# pending receive always crosses a test boundary and the ops
# sanitizer fails every test in the file. Closing the socket
# per test means one Chrome per test, against the one Chrome
# per file this suite is built on.
TZ=UTC deno test --frozen --no-check \
    --sanitize-resources \
    --allow-env --allow-read --allow-write \
    --allow-net --allow-run \
    --preload ./tests/hmac-test-key.ts \
    --preload ./tests/local-storage-stub.ts \
    tests/browser/*.test.ts
