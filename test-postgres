#!/bin/bash
set -euo pipefail
if [ -z "${POSTGRES_URL:-}" ]; then
    echo "POSTGRES_URL is required" >&2
    exit 1
fi
export SCHEMA_NAME="fusion_test_$(date +%s)_$$"
# No --parallel: the seven files share one Postgres and
# run serially. No preloads: the files bring their own
# fixtures. Permissions are ./test's minus write, and
# --allow-run is unscoped where ./test names four scripts:
# no file in these seven graphs spawns anything (291
# modules, zero Deno.Command), so there is nothing to name.
DENO_PG_TEST=(
    deno test --frozen --no-check
    --sanitize-ops --sanitize-resources
    --allow-env --allow-read --allow-net --allow-run
)
TZ=UTC "${DENO_PG_TEST[@]}" \
    tests/pg-acceptance.test.ts \
    tests/pg-races.test.ts \
    tests/pg-boot.test.ts \
    tests/pg-seed.test.ts \
    tests/pg-explain.test.ts \
    tests/pg-identifier-order.test.ts \
    tests/schema-lifecycle.test.ts
