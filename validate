#!/bin/bash
set -euo pipefail

npx --no-install tsc --noEmit -p web-app/app/tsconfig.json

./test

AWK_LINT='length > 78 {
    printf "%s:%d: %d chars\n", FILENAME, FNR, length
}'

LONG_LINES=$( {
    find api web-app tests shared server -type f \
        \( -name '*.ts' -o -name '*.html' -o -name '*.css' \) \
        ! -path 'web-app/app/compose.ts' \
        -exec awk "$AWK_LINT" {} +
    find . -maxdepth 1 -type f -name '*.md' \
        ! -name 'TEST-PLAN.md' \
        -exec awk "$AWK_LINT" {} +
    awk "$AWK_LINT" build serve test test-postgres \
        validate generate-schema-svg \
        generate-api-documentation measure \
        wipe-render-postgres
} )

if [ -n "$LONG_LINES" ]; then
    echo "Error: lines exceed 78 characters:" >&2
    echo "$LONG_LINES" >&2
    exit 1
fi

# Reject the `org` abbreviation in identifiers; use `organization`.
# Prose, URLs (w3.org), and CSS class names may keep the short form.
ORG_ABBREV=$(
    find api web-app tests shared server -type f \
        \( -name '*.ts' -o -name '*.html' -o -name '*.css' \) \
        ! -path 'web-app/app/compose.ts' -print0 \
    | xargs -0 perl -ne '
        close ARGV if eof;
        print "$ARGV:$.: $_"
            if /org[A-Z]|[a-z]Org([A-Z]|\b)|\bOrg[A-Z]/
            || /[a-z]Orgs([A-Z]|\b)|\bOrgs[A-Z]/
            || /_ORG(_|[0-9]|\b)|\bORG(_|[0-9])/;
    '
)

if [ -n "$ORG_ABBREV" ]; then
    echo "Error: 'org' abbreviation in identifiers:" >&2
    echo "$ORG_ABBREV" >&2
    exit 1
fi

# SCHEMA.svg is derived from the schema; fail if it has drifted.
./generate-schema-svg --check

# API.svg and rooms are derived from routes[];
# fail if they have drifted.
./generate-api-documentation --check
