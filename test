#!/bin/bash
set -euo pipefail

# Instants render in LOCAL time, so date-formatting output shifts
# with the runner's zone — a false prophet on a non-UTC machine.
# Pin UTC for the main suite (deterministic), then verify the
# instant-vs-calendar distinction under a fixed offset zone in
# tests/tz/ (Honolulu, UTC-10, no DST). The tests/*.test.ts glob
# is non-recursive, so it excludes tests/tz/.
export JWT_HMAC_SIGNING_KEY="${JWT_HMAC_SIGNING_KEY:-test-hmac-signing-key}"
TZ=UTC node --strip-types \
    --import ./tests/hmac-test-key.ts \
    --test tests/*.test.ts
TZ=Pacific/Honolulu node --strip-types \
    --import ./tests/hmac-test-key.ts \
    --test tests/tz/*.test.ts
